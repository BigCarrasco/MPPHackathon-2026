# Testnet only. Run npm run setup:testnet to create disposable accounts and request faucet funds.
MPP_SECRET_KEY=
MPP_RECIPIENT=
TEMPO_TESTNET_PRIVATE_KEY=
# Required for public hosting. Use at least 12 characters and share privately with evaluators.
DEMO_ACCESS_CODE=
# Amounts in millionths of test pathUSD (10000 = 0.01).
QUOTE_MAX_FEE_MICROS=10000
QUOTE_DAILY_BUDGET_MICROS=50000
QUOTE_MAX_DAILY=5
QUOTE_MAX_PACKAGES=50
QUOTE_PAUSED=false
